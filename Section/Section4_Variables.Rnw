\subsubsection*{Bank-Specific variables}   

\begin{itemize} [leftmargin=*,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
 \item \textbf{Non-Performing Loans to total gross loans [NPL]}
 		\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
		\item  \textbf{\textit{Definition}}:\\ Harmonized definition  of NPL across European countries introduced by the EBA in 2014 for supervisory reporting. In general, Non-Performing Loans (NPL) are loans  that satisfy either of the following criteria: (a) material exposures that are more than 90 days past due; and (b) the debtor is assessed as unlikely to pay its credit obligations in full without realization of collateral, regardless of the existence of any past due amount or of the number of days past due (\cite{EBA}; \cite{NPL2}).
		
 		\item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database, author's calculations
 		\par
\begingroup
\leftskip1em
\rightskip\leftskip
 \textit{Group}: cre (Credit Risk and Asset Quality)\\
\textit{Sheet}:  NPE\\
\textit{Item Number from EBA 2020}: 2020605 [Gross carrying amount on Loans and advances ]\\
\textit{Dimensions (perf\_status) from EBA 2020}:

\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
        \item 0=No breakdown by Performing status
        \item 1=Performing
        \item 2=Non Performing
        \item 3=Performing but past due $>$30 days and $<$=90 days
        \item 4=Non Performing and Defaulted
        \item 5=Loans and advances subject to impairment
    \end{itemize}
    
\par
\endgroup


 		
 		\item  \textbf{\textit{Calculation}} (\cite{EBA2}): 
 		\[  \dfrac{\text{Perf\_status=('2')2020605[Gross carrying amount on Loans and advances]}}{\text{Perf\_status=('0')2020605[Gross carrying amount on Loans and advances]}} \]		
 		\end{itemize}
 

\item \textbf{Single Supervisory Mechanism [SSM]}:
 		\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
		\item  \textbf{\textit{Definition}}:\\ The Single Supervisory Mechanism (SSM) refers to the system of banking supervision in Europe created as an EU policy response to  the large accumulations of  NPL stocks and the threat of financial instability in many European countries, and it represents a step further in the process of European integration. The SSM is also one of the pillars of the EU banking union along with the Single Resolution Mechanism, and it is composed of the European Central Bank (ECB) and the national supervisory bodies of the participating EU member states (\cite{lex}). In this framework, the European Central Bank (ECB) assumed specific responsibilities in the supervision of the banking sector and also provides guidance on the setting of NPL strategies (\cite{guideline}).
		
 		\item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database (Metadata/Bank Lists)
 		
 		\item  \textbf{\textit{Calculation}}:\\ 
 	Variable Identification for banks  under the framework of the Single Supervisory Mechanism(Y:YES/N:NO)	
 		\end{itemize}


\item  \textbf{Bank Size  (Min EUR)[BankSize\_tran]}

	\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
		\item  \textbf{\textit{Definition}}:\\
		Proxy variable for total bank assets
		
 		 \item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database
 \par
\begingroup
\leftskip1em
\rightskip\leftskip
 \textit{Group}: otr (solvency)\\
\textit{Sheet}:  Leverage\\
\textit{Item Number from EBA 2020}: 2020903 [Total leverage ratio exposures - using a transitional definition of Tier 1 capital]

\par
\endgroup
 		\end{itemize}
 		
 

\item  \textbf{Common Equity Tier 1 Ratio [CET1\_ratio\_tr]}
	\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
		\item  \textbf{\textit{Definition}}:\\ 	
CET1 ratio shows a bank's core capital against its risk-weighted assets to assess its ability to resist financial distress.
Common Equity Tier 1 (CET1) is a component of Tier 1 Capital, and it includes the core capital that a bank holds in its capital structure. It encompasses  equity capital (ordinary shares) and disclosed reserves such as retained earnings (\cite{EBA6}).
		
 		\item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database
 		\par
\begingroup
\leftskip1em
\rightskip\leftskip
 \textit{Group}: otr (solvency)\\
\textit{Sheet}: Capital\\
\textit{Item Number from EBA 2020}: 
\begin{itemize} [label= $ $,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item 2020140 [Common Equity TIER 1 Capital Ratio (transitional period)]

\end{itemize}

%\begin{itemize} [label= $ $]
%\item 2020102 [Common Equity Tier 1 Capital(net of deductions and after applying %transitional adjustments)]
%\item 2020220 [Total Risk exposure amount]
%\end{itemize}

\par
\endgroup
 		
 		%\item  \textbf{\textit{Calculation}} \cite{EBA2}: 
 	%	\[  \dfrac{2020102 \text{ [Common Equity Tier 1 Capital]}}{2020220 \text{ [Total Risk exposure amount]}} \]		
 		\end{itemize}
 
\item \textbf{Cost to Income [Cost\_to\_Income]}
 
 	\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
		\item  \textbf{\textit{Definition}}:\\ 
		The cost-income ratio is based on consolidated banking data. It shows  bank's operating costs as a percentage of net operating income, and it is used as a further indicator of a bank's cost efficiency. Consolidation refers to the elimination of positions and flows within individual banks or banking groups (\cite{OENB}).
		
 		\item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database, author's calculations
 		\par
\begingroup
\leftskip1em
\rightskip\leftskip
 \textit{Group}: otr (Profitability)\\
\textit{Sheet}: P\&L\\
\textit{Item Number from EBA 2020}: 
\begin{itemize} [label= $ $,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item 2020317 [(Administrative expenses)]
\item 2020318 [(Depreciation)]
\item 2020316 [Total Operating Income\_Net]
\end{itemize}

\par
\endgroup
 		
 		\item  \textbf{\textit{Calculation}} (\cite{EBA2}): 
 		\[  \dfrac{\text{2020317 [(Administrative expenses)]} + \text{2020318 [(Depreciation)]} }{ \text{2020316 [Total Operating Income\_Net]}} \]		
 		\end{itemize}
 

\item \textbf{Leverage ratio [LEVER\_tr\_ratio]}
		\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\ 
		the Tier 1 Leverage ratio compares a bank's capital against its total assets. This ratio is used to evaluate how much leverage a bank shows with respect to its consolidated assets. The denominator is composed of Tier 1 assets, which are  assets that can be easily liquidated if a bank needs capital in the event of a financial crisis and the numerator is composed of all the components of the Tier 1 capital, which represents a bank's common equity, retained earnings, reserves and certain instruments with discretionary dividends and no maturity (\cite{EBA6}).
		
 		\item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database, author's calculations
 		\par
\begingroup
\leftskip1em
\rightskip\leftskip
 \textit{Group}: oth (Solvency)\\
\textit{Sheet}: Leverage\\
\textit{Item Number from EBA 2020}: 
\begin{itemize} [label= $ $,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item 2020905 [Leverage ratio - using a transitional definition of Tier 1 capital]

\end{itemize}

    
\par
\endgroup
		
 		\end{itemize}
 		

\item \textbf{Net Interest Margin  [NIM\_tr]}

\renewcommand{\thefootnote}{\fnsymbol{footnote}}
		\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\ 
		Net interest margin is calculated by dividing the difference between the interest income generated  by a bank's lending operations and the interest expenses paid out to lenders by the bank's average earning assets. It is an industry-specific profitability ratio for banks and other financial institutions that lend out interest-earning assets. Net interest margin is one indicator of a bank's profitability and growth (\cite{EBA6}).

 		\item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database, author's calculations
 		\par
\begingroup
\leftskip1em
\rightskip\leftskip
 \textit{Group}: oth (Profitability)\\
\textit{Sheet}: P\&L\\
\textit{Item Number from EBA 2020}: 
\begin{itemize} [label= $ $,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item 2020301 [Interest income]
\item 2020304 [Interest expenses]
\item 2020903 [Total leverage ratio exposures - using a transitional definition of Tier 1 capital]\footnote[1]{Proxy for total bank assets}
\end{itemize}

\par
\endgroup
		
 		\item  \textbf{\textit{Calculation}} (\cite{EBA2}): 
 		\[  \dfrac{\text{2020301 [Interest income]}-\text{2020304 [Interest expenses]}}{\text{ 2020903 [Total leverage ratio exposures - using a transitional definition of Tier 1 capital]}} \]		
 		\end{itemize}
 
\item \textbf{Return on Regulatory (Risk-Adjusted) Capital [RORAC]}

		\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\ 
	 Return On 	Risk-Adjusted Capital (RORAC) is a risk-adjusted measure of returns on investment. It accounts for any expected losses and income generated by capital under the assumption that riskier assets  are expected to be followed by higher expected returns. The definition of RORAC is closely related to the definition of Return on Equity (ROE), with the exception that the denominator is adjusted to account for the amount of risk (\cite{EBA6}).
%\cite{CorI}.
	
 		\item  \textbf{\textit{Source}}:\\ EBA Transparency Exercise-Database, author's calculations
 		\par
\begingroup
\leftskip1em
\rightskip\leftskip
 \textit{Group}: oth (Profitability)\\
\textit{Sheet}: P\&L/Capital\\
\textit{Item Number from EBA 2020}: 
\begin{itemize} [label= $ $,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item 2020335 [Profit or (-) Loss for the year]
\item 2020133 [TIER 1 CAPITAL (net of deductions and after transitional adjustments)]
\footnote[2]{Tier 1 capital is the most adequate form of a bank's capital}
\end{itemize}
 %(\cite{EBA6)
\par
\endgroup
		
 		\item  \textbf{\textit{Calculation}}: 
 		\[  \dfrac{\text{2020335 [Profit or (-) Loss for the year]}}{\text{ 2020133 [TIER 1 CAPITAL (net of deductions and after transitional adjustments)]}} \]		
 		\end{itemize}


 
 \item \textbf{Cross-Border Diversification Index [CBDI]}

		\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\ 
	 The $CBDI$ index is used to measure the geographic diversification of bank exposures. A Cross-Border  Diversification Index ($CBDI$) close to its maximum means that the bank original exposures  are very diversified across countries, whereas an index close to zero means that the bank  original exposures are very concentrated on certain countries (\cite{Morgan.2016}).
	 
\item \textbf{Item Name:} Original Exposure - by exposure class (SA\_and\_IRB)
 		\item  \textbf{\textit{Source}}:\\EBA Transparency Exercise-Database, author's calculations
 		\par
\begingroup
\leftskip1em
\rightskip\leftskip
\textit{Group}: cre (Credit Risk)\\
\textit{Sheet}: Credit Risk\\
\textit{Item Number from EBA 2020}: 
\begin{itemize} [label= $ $]
\item 2020502 [Original Exposure - by exposure class (SA\_and\_IRB)]
\end{itemize}


\par
\endgroup

    \item \textbf{Dimensions}: 
    \begin{itemize}[label=$-$,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
    \item  Country\_rank:\\ 
    Taking values from 1 (1st-largest country exposures) up to 10 (10th-largest country exposure)
    
    \item Country/ISO\_code:\\
    Country identification number and ISO country codes to designate every country as a two-letter combination.
	  \end{itemize}
 		\item  \textbf{\textit{Calculation}}: 
 		The Cross-Border Diversification Index ($CBDI$) has been calculated as  the inverse of the Hirschmann-Herfindahl Index (HHI) for each bank $i$ at time $t$ as described in the section Data (\cite{Morgan.2016}).
 		
 		
 		\end{itemize}
 				

\end{itemize}

\subsubsection*{Macroeconomic indicators}

\begin{itemize} [leftmargin=*,topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item  \textbf{Inflation, consumer prices (annual \%) [infl\_perc]}


		\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\ Inflation as calculated by the consumer price index  represents the percentage change on an annual basis of the cost for the average consumer of acquiring a basket of goods and services. The Laspeyres formula is generally used for its calculation.
		
		\item  \textbf{\textit{Source}}:\\ World Bank Data
		\item  \textbf{\textit{Indicator Code}}:\\ FP.CPI.TOTL.ZG
 		\item  \textbf{\textit{Organization}}:\\
 		 International Financial Statistics and the International Monetary Fund (IMF). 		
		\end{itemize}


%https://www.doingbusiness.org/en/methodology/getting-credit
\item \textbf{Strength of legal rights index (0=weak to 12=strong) [Stgth\_legal\_index]}

\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\ Strength of legal rights index is  a measure of the strength of collateral and bankruptcy laws with respect to legal aspects influencing the extension of new credit. The index shows values between 0 and  12, with higher scores indicating that these laws are better designed to expand access to credit (ex-ante).
		
		\item  \textbf{\textit{Source}}:\\ World Bank Data
		\item  \textbf{\textit{Indicator Code}}:\\ IC.LGL.CRED.XQ
 		\item  \textbf{\textit{Organization}}:\\
 		World Bank, Doing Business project (\url{http://www.doingbusiness.org/}).	
		\end{itemize}

\item \textbf{GDP growth (annual \%) [GDP\_growth\_perc]}

\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\	
		
Annual percentage growth rate of GDP at market prices on constant local currency. GDP is calculated as the sum of gross value added by all  producers that resides in the economy minus  subsidies plus taxes. 
		
		\item  \textbf{\textit{Source}}:\\ World Bank Data
		\item  \textbf{\textit{Indicator Code}}:\\NY.GDP.MKTP.KD.ZG
 		\item  \textbf{\textit{Organization}}:\\
 		World Bank national accounts data, and OECD National Accounts data files.
		\end{itemize}
		

\item \textbf{Recovery rate (cents on the dollar) [Reco\_rate\_dol]}


\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\		
		The recovery rate indicates amount recovered by creditors as cents on the dollar through  debt restructuring, debt execution (foreclosure) or bankruptcy proceedings.
		
		\item  \textbf{\textit{Source}}:\\ World Bank Data
		\item  \textbf{\textit{Indicator Code}}:\\RESLV.ISV.RCOV.RT
 		\item  \textbf{\textit{Organization}}:\\
 	World Bank, Doing Business project (\url{http://www.doingbusiness.org/}).	
		\end{itemize}

\item \textbf{Unemployment rate [unempl\_rate\_imf]}


\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 
		\item  \textbf{\textit{Definition}}:\\				 	
The number of unemployed persons as a percentage of the total labor force.

%\cite{ILO}.
		
		\item  \textbf{\textit{Source}}:\\International Monetary Fund Data (IMF)
 		\item  \textbf{\textit{Organization}}:\\
 	    World Economic Outlook Database
		\end{itemize}




\item \textbf{Current account balance, percent of GDP [curr\_acc\_bal]}

\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 

		\item  \textbf{\textit{Definition}}:\\						 	
The current account includes all transactions in the balance of payments that cover exports and imports of goods and services, payments of income, and current transfers between residents and nonresidents of a country.
		
		\item  \textbf{\textit{Source}}:\\International Monetary Fund Data (IMF)
 		\item  \textbf{\textit{Organization}}:\\
 	    World Economic Outlook Database
\end{itemize}


\item \textbf{General government gross debt, percent of GDP [gross\_public\_debt]}

\begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt] 

		\item  \textbf{\textit{Definition}}:\\						 
		Gross debt consists of all external financial obligations that governments accumulate to finance public expenditures above the available public revenues. This includes debt liabilities such as Special Drawing Rights (SDRs), debt securities, loans, insurances, pensions, currency, deposits and other payables.

		\item  \textbf{\textit{Source}}:\\International Monetary Fund Data (IMF)
 		\item  \textbf{\textit{Organization}}:\\
 	    World Economic Outlook Database
\end{itemize}
		


\end{itemize}
