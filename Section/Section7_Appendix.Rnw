 library(tidyverse)
 path_data <-  file.path(getwd(), "Data")
 
 load(paste(path_data,'all.RData', sep = "/"))
library(plyr)
 
all%>%  dplyr::select(-NPL_ratio) %>% keep(is.numeric) %>%  gather() %>% 
  ggplot(aes(sample=value )) + geom_qq(distribution = qnorm) + 
  geom_qq_line(line.p = c(0.25, 0.75), col = "blue") +
  facet_wrap(~ key, scales = "free") +
  # geom_abline(intercept = 0, slope = 1) +
  xlab("Theoretical Quantiles") +
  ylab("Sample")+
  #ylim(-4, 4)+
  scale_x_continuous(breaks=seq(-4,4,1) )+
  #scale_y_continuous(breaks=seq(0,25,100),limits=c(0,100) )+
  #stat_qq_line(color="grey",linetype="dashed")+
