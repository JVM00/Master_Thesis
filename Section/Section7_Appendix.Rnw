\caption[Fixed Effects Quantile Regression Graphics ($\lambda=1$)-Home Exposure $\geq$ 75\%]{Fixed Effects Quantile Regression Graphics ($\lambda=1$)-Home Exposure $\geq$ 75\%\\ {\footnotesize \textit{Source: EBA Transparency Exercises, Worldbank and IMF data, authors' calculations}}}

\label{feqq1.graph.75}
