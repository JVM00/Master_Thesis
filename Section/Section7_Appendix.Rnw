  names.z1 <- z1 %>%dplyr::select(-NPL_ratio) %>% keep(is.numeric) %>%names()
  z2 <-z1 %>% dplyr::select(id,all_of(names.z1)) %>% gather(key="var.name",value="value",-id)
  z3 <- z1 %>% dplyr::select(id,NPL_ratio)
  z4 <-  z2 %>% left_join(z3,"id"="id")
  
  z4 %>% ggplot(aes(x=NPL_ratio,y=value)) +
    geom_point(alpha=0.2) +
    facet_wrap(~var.name,scales = "free")+
    # labs(x= "Seats Sold", y="Weekly Gross")+
    geom_smooth(method = "lm", se=TRUE, color="red", formula = y ~ x)

  
    all1%>%  dplyr::select(-NPL_ratio) %>% keep(is.numeric) %>%  gather() %>% 
