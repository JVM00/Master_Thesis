 library(dplyr)
   
 t<-  all %>% group_by(Year,name) %>% summarise(sum_0=sum(npl_0),sum_2=sum(npl_2),NPL_ratio=sum_2/sum_0) %>% dplyr::select(Year,name,NPL_ratio) %>% mutate(Year_nm= as.numeric(Year),name_nm=as.character(name))
all1 <- as.data.frame(npl_nfi)%>% dplyr::select(-NPL_ratio) %>% mutate(Year_nm= as.numeric(Year),name_nm=as.character(name)) %>% left_join( t, by=c("Year_nm","name_nm")) %>% 
  dplyr::select(
  NPL_ratio , 
  
  CET1_ratio_tr ,

  LEVER_tr_ratio ,
  
  RORAC ,
  #RORWA+
  
  #log(npl_0) +
  BankSize_tran ,
  
  Cost_to_Income ,

  NIM_tr ,
  #NFCI +
