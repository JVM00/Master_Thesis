 t <- npl_hh.nfi%>% keep(is.numeric)
  col <- colorRampPalette(c("#BB4444", "#EE9988", "#FFFFFF", "#77AADD", "#4477AA"))
library(corrplot)
  def_model_ALL_corr <- update(def_model_ALL_descr ,.~.-SSM)
corr.hh.nfi <- round(cor(npl_hh.nfi[all.vars(def_model_ALL_corr)]),5)
  corrplot(corr.hh.nfi, method="color", col=col(200),
           type="lower",
           addCoef.col = "grey39", # Add coefficient of correlation
           tl.col="black", 
             #title= "Households",
           tl.srt=90, #Text label color and rotation
           # Combine with significance
           number.cex=0.7,tl.cex = .7,
           # hide correlation coefficient on the principal diagonal
           diag=TRUE
           #,mar=c(0,0,1,0)
