 \begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item \textit{What is the impact of macroeconomic and bank-specific factors on Non-Performing Loans (NPL) in the EU-banking sector?}
\item \textit{Which of the factors have a significant and positive correlation with NPL?}
\item \textit{Which of the factors have a significant and negative correlation with NPL?}
\end{itemize}
\textbf{Specific Questions:}
  \begin{itemize}[topsep=0pt, partopsep=0pt,itemsep=0.5 pt,parsep= 0.5 pt]
\item \textit{What is the impact of Supervision under the Single Supervisory Mechanism (SSM) on Non-Performing Loans?}
 
\item \textit{What is the impact of geographic diversification on Non-Performing Loans?}

