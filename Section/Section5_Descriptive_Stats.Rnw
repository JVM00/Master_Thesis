 <<Loan_dist,fig.width=8, fig.height=6,fig.pos="h", out.width='0.9\\linewidth',fig.show='hide'>>=
   
    library(tidyverse)
library(rstudioapi)
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))

path_data <-  file.path(getwd(), "Data")

load(paste(path_data,'all.RData', sep = "/"))
#load(paste(path_data,'npl_hh.nfi.RData', sep = "/"))

library(plyr)
all1 <- all %>% mutate(Exposure= as.factor(Exposure)) 
all1$Exposure <- plyr::revalue(all1$Exposure,c("202" = "Financial Corporations", "301" = "Non-Financial Corporations","401" = "Households"))

detach(package:plyr)
 t<-  all1%>% group_by(Year,Exposure) %>%
  summarise(sum=sum(npl_0))

t2 <- all1%>% group_by(Year) %>% summarise(sum_all=sum(npl_0))
t3 <- t %>% left_join( t2, by=c("Year")) %>% mutate( pct2= sum/sum_all)



ta<-  all1%>% group_by(Year,Exposure) %>%
  summarise(sum=sum(npl_2))

t2a <- all1%>% group_by(Year) %>% summarise(sum_all=sum(npl_2))
t3a <- ta %>% left_join( t2a, by=c("Year")) %>% mutate( pct2= sum/sum_all)

  ggplot(t3 ,
       aes(x=Year, y=pct2,fill=Exposure)) +
  geom_col()+
  xlab(" ") +
  ylab(" ")+
  # scale_fill_grey()+
  theme_light()+
  geom_text(aes(label = scales::percent(pct2)),
            position="stack",vjust=+2.3,col="black",size=5)+
  #facet_wrap(~ Exposure, nrow = 3)+
  # scale_fill_manual(values = c("lightslategray","lightblue"))+
  # scale_fill_manual(values = c("lightblue4","lightgoldenrod1"))+
  scale_fill_manual(values = alpha(c("lightblue4","goldenrod1","palegreen"),.7),name = " ", labels = c("Financial Corp.", "Households","Non-Financial Corp."))+
  scale_y_continuous(label = scales::percent)+
  theme(plot.title = element_text(hjust = 0.5,size=8))+
  # theme(strip.background =element_rect(fill="lightblue4"))+
  # theme(strip.text = element_text(colour = 'white'))+
  theme(panel.background = element_rect(fill = "lightgray"),axis.text.x = element_text(angle = 30, hjust = 1, vjust = 1))+
  theme(plot.caption = element_text(color = "black", face = "italic",hjust = 0.0))+
  #theme(legend.position="right",legend.direction = "vertical",legend.spacing.x = unit(.5, 'cm'))+
  theme(legend.position="bottom",legend.direction = "horizontal",legend.spacing.x = unit(.5, 'cm'))+
 # labs(caption = " ")
  labs(caption = "Source: EBA Transparency Exercises, authors' calculations")
 # ggtitle("Total Gross Loans Portfolio per Exposure Type (%)")


@

 \begin{figure}[hbt] % between [] you put options e.g. ht = here top
% \hspace*{-0.5cm}
 %\hspace*{-2cm}
\centering
%\rule{12.8cm}{7.2cm}
%\setlength{\abovecaptionskip}{5pt}
\makebox[\textwidth]{\includegraphics[width=0.8\paperwidth]{figure/Loan_dist-1}}
\vspace{-1cm}}
\caption{Total Gross Loans Portfolio per Exposure Type (\%)}
\label{Loan_dist}
 \vspace*{-3mm}
\end{figure}
Figure \ref{Loan_dist} shows the total gross loans portfolio distribution per exposure type for the  period 2014-2019. The distribution illustrates that non-financial corporations and households  represent around 90\% of the total loans in the sample  while financial corporations other than credit institutions only represent around 10\%. In particular, approximately 50\%  of  gross loans are granted to non-financial corporations followed by households with around 40\%. This distribution  among exposures types seems to be quite constant during the period considered.

 <<NplRatios,fig.width=5, fig.height=4, out.width='.89\\linewidth',fig.show='hide'>>=
#setwd("C:/Users/varga/Desktop/Thesis/Master_thesis/Output/Chapters/Chapter_2/Figures")
#getwd()
 
 
 library(tidyverse)
path_data <-  file.path(getwd(), "Data")
 
 load(paste(path_data,'all.RData', sep = "/"))
library(plyr)
 all <- all %>% mutate(Exposure= as.factor(Exposure)) 
 all$Exposure <- revalue(all$Exposure,c("202" = "Financial Corporations", "301" = "Non-Financial Corporations","401" = "Households"))

  all %>% ggplot(aes(x=Year, y=NPL_ratio)) + 
  stat_boxplot(geom = "errorbar", width = 0.2) +
  geom_boxplot(outlier.colour = "red", outlier.alpha = 0.3,fill="lightsteelblue2")+
  xlab("Year") +
  ylab("NPL ratio(%)")+
 # scale_fill_discrete("",labels = c("Financial Institutions","Non-Financial Institutions","Households"))+
  facet_wrap(~ Exposure, nrow = 1)+
  #scale_fill_brewer("",labels = c("Financial Institutions","Non-Financial Institutions","Households"),palette = "RdYlBu") +
  #scale_fill_discrete("",labels = c("Financial Institutions","Non-Financial Institutions","Households")) +
  #scale_fill_manual("",labels = c("Financial Institutions","Non-Financial Institutions","Households"), values = c("lightyellow", "lightsteelblue2","palegreen"))+
    #scale_colour_manual(values = c("lightsteelblue2"))+
  scale_y_continuous(breaks=seq(0,100,10),labels = scales::percent_format(accuracy = 1,scale = 1))+
  theme_bw()+
  theme(plot.title = element_text(hjust = 0.5,size=8))+
 theme(strip.background =element_rect(fill="lightblue4"))+
  theme(strip.text = element_text(colour = 'white',size = 8))+
  theme(legend.position="bottom",panel.background = element_rect(fill = "lightgray"),
        axis.text.x = element_text(angle = 30, hjust = 1, vjust = 1),axis.title.x = element_blank(),axis.title.y = element_blank())+
    theme(axis.text=element_text(size=8))+   
    theme(plot.caption = element_text(color = "black", face = "italic",hjust = 0.0))+
  labs(caption = "Source: EBA Transparency Exercises, authors' calculations")
 #ggtitle("Boxplot")
  

