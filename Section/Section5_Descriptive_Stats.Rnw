   scale_x_continuous(breaks=seq(0,100,25),limits = c(0, 100),labels = scales::percent_format(accuracy = 1,scale = 1))+
   scale_y_continuous(labels = scales::percent_format(accuracy = .1,scale = 100))+
    #theme_bw()+
   theme(plot.title = element_text(hjust = 0.5,size=8))+
   theme(strip.background =element_rect(fill="lightblue4"))+
   theme(strip.text = element_text(colour = 'white',size = 8))+
   theme(legend.position="bottom",panel.background = element_rect(fill = "lightgray"),axis.text.x = element_text(angle = 30, hjust = 1, vjust = 1),axis.title.x = element_text(face = "italic"))+
   ggtitle("Density")

 
 b1 <-all1 %>% ggplot(aes(sample=NPL_ratio )) + geom_qq(distribution = qnorm) + 
  geom_qq_line(line.p = c(0.25, 0.75), col = "blue") + facet_wrap(~ Exposure, nrow = 1)+
xlab("Theoretical Quantiles") +
  ylab(" ")+
    scale_x_continuous(breaks=seq(-4,4,1) )+
     scale_y_continuous(labels = scales::percent_format(accuracy = 1,scale = 1))+
  theme(plot.title = element_text(hjust = 0.5,size=8))+
  
  theme(strip.background =element_rect(fill="lightblue4"))+
  theme(strip.text = element_text(colour = 'white',size = 8))+
  theme(plot.caption = element_text(color = "black", face = "italic",hjust = 0.0))+
  labs(caption = "Source: EBA Transparency Exercises, authors' calculations")+
     theme(legend.position="bottom",panel.background = element_rect(fill = "lightgray"),axis.text.x = element_text(angle = 30, hjust = 1, vjust = 1),axis.title.x = element_text(face = "italic",size=6))+
  ggtitle("Q-Q Diagram")
  
 library(ggpubr)
   ggarrange( a2,b1,
           labels = c( " "," "),
           nrow = 2)  
   
