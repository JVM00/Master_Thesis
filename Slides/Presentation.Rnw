 <<ExposuresRatio,fig.width=6, fig.height=5, out.width='.89\\linewidth',fig.show='hide'>>=
#setwd("C:/Users/varga/Desktop/Thesis/Master_thesis/Output/Chapters/Chapter_2/Figures")
#getwd()
 

 library(tidyverse)
library(plyr)
 path_data <- 'C:/Users/varga/Desktop/Thesis/R_data/Data/'
 
load(paste(path_data,'base_eu4.RData', sep = ""))
 
base_eu5 <- base_eu4 %>% group_by(Year,class) %>%summarise_at(vars(exp_ratio),list( exp.mean=mean,exp.median=median))
  

#path_Graph <- 'C:/Users/varga/Desktop/Thesis/R_data/Research_Proposal/Progress/Graphs/'

 base_eu4  %>% ggplot( mapping= aes(x=exp_ratio,y=..density..,color=class,fill=class)) + 
  xlab("") +
  ylab("count")+
 # geom_histogram(binwidth = 0.1,position="identity",alpha=.5)+ 
  scale_x_continuous(breaks=seq(0,1,.25),labels = scales::percent_format(accuracy = 1,scale = 100))+
   geom_density(alpha = .5,size=1)+
  geom_vline(data=base_eu5,aes( xintercept=exp.mean,color=class), linetype="dashed", size=1)+
  guides(col = FALSE)+
 facet_wrap(~ Year, nrow = 3)+
  #theme_light()+
  theme_bw()+
  theme(plot.title = element_text(hjust = 0.5))+
  theme(strip.background =element_rect(fill="lightblue4"))+
  theme(strip.text = element_text(colour = 'white'))+
  # theme_classic()
  #theme_economist() + 
  #scale_color_economist()+
  theme(legend.position="bottom",panel.background = element_rect(fill = "lightgray"),
      axis.text=element_text(size=10)
      )+
  #theme(legend.position = "none")+
 # scale_fill_discrete("",labels = c("EU","Domestic"))+
   scale_fill_manual("",labels = c("EU","Domestic"),values = c("indianred1", "steelblue2"))+
  scale_colour_manual(values = c("indianred1", "steelblue2"))+
  #scale_fill_manual("",labels = c("EU","Domestic"),values = c("red", "blue"))
    theme(plot.caption = element_text(color = "black", face = "italic",hjust = 0.0))+
  labs(caption = "Source: EBA Transparency Exercises, authors' calculations")
 # ggtitle("Exposures Ratio Distribution: EU & Domestic")


@


