 <<countrydestination2,fig.width=8, fig.height=6, out.width='.89\\linewidth',fig.show='hide'>>=
#setwd("C:/Users/varga/Desktop/Thesis/Master_thesis/Output/Chapters/Chapter_2/Figures")
#getwd()


 library(tidyverse)
 path_data <- 'C:/Users/varga/Desktop/Thesis/R_data/Data/'
 
 load(paste(path_data,'country_diversification.RData', sep = ""))
 
library(plyr)
 
 CBDI.1<- country_diversification %>% group_by(Country_label)%>% dplyr::count() %>% mutate(Type=1)
CBDI.2 <- country_diversification%>% dplyr::count()%>% mutate(n_all=n,Type=1) %>%  dplyr::select(n_all,Type)
#CBDI.3 <-  CBDI.1  %>% mutate( pct2= round( (n/ CBDI.2 [1,1])*100,3))
CBDI.3 <-  CBDI.1  %>% left_join(CBDI.2,by="Type") %>%  mutate( pct2=  n/n_all)

CBDI.3 <- CBDI.3 %>% mutate(Country_label= as.factor(Country_label)) 
 CBDI.3$Country_label <- revalue(CBDI.3$Country_label,c("Macedonia - The former Yugoslav Republic of" = "Macedonia","Bosnia and Herzegowina"="Bosnia","Taiwan Province of China"="Taiwan"))
 #detach("package:plyr")

 
 ggplot(CBDI.3,
       aes(x=Country_label, y=pct2)) +
  geom_bar(  stat='identity', position = 'stack',fill="lightblue4")+
  #geom_bar(  stat='identity',fill="lightblue4")+
 # coord_flip()+
  xlab("") +
  ylab("%")+
  # scale_fill_grey()+
  theme_light()+
   geom_text(aes(x=Country_label, y=pct2,label = scales::percent(pct2,accuracy = .01,scale = 100), group =Country_label),position=position_dodge(width = 1),vjust = -0.5, size = 2,col="black")+
  # position="stack",vjust=+2.3,col="black",size=3)+
  #facet_wrap(~ Exposure, nrow = 3)+
  #scale_fill_manual(values = c("lightslategray","lightblue"))+
  # scale_fill_manual(values = c("royalblue2","lightgoldenrod1"))+
  # scale_fill_manual(values = c("royalblue2","goldenrod1"),name = " ", labels = c("NO", "YES"))+
  scale_y_continuous(label =  scales::percent_format(accuracy = .01,scale = 100),breaks=seq(0,.1,0.01),limits = c(0, .1)  )+
  theme(plot.title = element_text(hjust = 0.5,size=8))+
  theme(strip.background =element_rect(fill="lightblue4"))+
  theme(strip.text = element_text(colour = 'white',size = 10))+
  theme(panel.background = element_rect(fill = "lightgray"),axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0))+
  theme(panel.background = element_rect(fill = "lightgray"))+
  theme(plot.caption = element_text(color = "black", face = "italic",hjust = 0.0))+
  #labs(caption = "Source: EBA Transparency Exercises, authors' calculations")+
  ggtitle("Tota Original Exposures Distribution: Top 10 largest Country of Destination  (2014-2020)")


