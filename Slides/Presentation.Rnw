 <<Loan_dist,fig.width=8, fig.height=6,fig.pos="h", out.width='0.9\\linewidth',fig.show='hide'>>=
   
    library(tidyverse)
path_data <- 'C:/Users/varga/Desktop/Thesis/R_data/Data/'

load(paste(path_data,'all.RData', sep = ""))
#load(paste(path_data,'npl_hh.nfi.RData', sep = ""))

library(plyr)
all1 <- all %>% mutate(Exposure= as.factor(Exposure)) 
all1$Exposure <- plyr::revalue(all1$Exposure,c("202" = "Financial Corporations", "301" = "Non-Financial Corporations","401" = "Households"))

detach(package:plyr)
 t<-  all1%>% group_by(Year,Exposure) %>%
  summarise(sum=sum(npl_0))

t2 <- all1%>% group_by(Year) %>% summarise(sum_all=sum(npl_0))
t3 <- t %>% left_join( t2, by=c("Year")) %>% mutate( pct2= sum/sum_all)



ta<-  all1%>% group_by(Year,Exposure) %>%
  summarise(sum=sum(npl_2))

t2a <- all1%>% group_by(Year) %>% summarise(sum_all=sum(npl_2))
t3a <- ta %>% left_join( t2a, by=c("Year")) %>% mutate( pct2= sum/sum_all)

  ggplot(t3 ,
       aes(x=Year, y=pct2,fill=Exposure)) +
    #aes(x=Year, y=(sum/1000),fill=Exposure)) +
  geom_col()+
  xlab("") +
  ylab(" ")+
  # scale_fill_grey()+
  theme_light()+
  geom_text(aes(label = scales::percent(pct2)),
            position="stack",vjust=+2.3,col="black",size=3)+
  #facet_wrap(~ Exposure, nrow = 3)+
  # scale_fill_manual(values = c("lightslategray","lightblue"))+
  # scale_fill_manual(values = c("royalblue2","lightgoldenrod1"))+
  scale_fill_manual(values = c("royalblue2","goldenrod1","firebrick2"),name = " ", labels = c("Financial Corp.", "Households","Non-Financial Corp."))+
 scale_y_continuous(label = scales::percent)+
    # scale_y_continuous(label = scales::percent)
  theme(plot.title = element_text(hjust = 0.5,size=8))+
  # theme(strip.background =element_rect(fill="lightblue4"))+
  # theme(strip.text = element_text(colour = 'white'))+
  theme(panel.background = element_rect(fill = "lightgray"),axis.text.x = element_text(angle = 30, hjust = 1, vjust = 1))+
  theme(plot.caption = element_text(color = "black", face = "italic",hjust = 0.0))+
  #theme(legend.position="right",legend.direction = "vertical",legend.spacing.x = unit(.5, 'cm'))+
  theme(legend.position="bottom",legend.direction = "horizontal",legend.spacing.x = unit(.5, 'cm'))+
  labs(caption = " ")
  #ggtitle("Total Gross Loans Portfolio per Exposure Type (%)")

