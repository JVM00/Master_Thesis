%\section[short_title2]{Research Question}
\section{Research Question} 
\frame{\frametitle{Research Question}
\begin{itemize}

    \item \textbf{Main question}:
    
    \textit{What are the main macroeconomic and bank-specific drivers of Non-Performing Loans in the EU-banking sector?}
    
    \item \textbf{Secondary questions}:\\
    Are there different conclusions given:
  
    
    \begin{itemize}
    \item \textit{Exposure types}
      \begin{itemize}
      \item Households
      \item Non-Financial Corporations
      \item Financial Corporations other than credit institutions
       \end{itemize}
       
       \item   \textit{NPL levels}
       
    \item \textit{Geographic diversification of exposures}
    
    \item \textit{Supervision under the Single Supervisory Mechanism (SSM)}
    
    \end{itemize}

\end{itemize}
}



