 library(tidyverse)
 path_data <- 'C:/Users/varga/Desktop/Thesis/R_data/Data/'
 
 load(paste(path_data,'all.RData', sep = ""))
library(plyr)
 all <- all %>% mutate(Exposure= as.factor(Exposure)) 
 all$Exposure <- revalue(all$Exposure,c("202" = "Financial Corporations", "301" = "Non-Financial Corporations","401" = "Households"))

  all %>% ggplot(aes(x=Year, y=NPL_ratio)) + 
  stat_boxplot(geom = "errorbar", width = 0.2) +
  geom_boxplot(outlier.colour = "red", outlier.alpha = 0.3,fill="lightsteelblue2")+
  xlab("Year") +
  ylab("NPL ratio(%)")+
 # scale_fill_discrete("",labels = c("Financial Institutions","Non-Financial Institutions","Households"))+
  facet_wrap(~ Exposure, nrow = 1)+
  #scale_fill_brewer("",labels = c("Financial Institutions","Non-Financial Institutions","Households"),palette = "RdYlBu") +
