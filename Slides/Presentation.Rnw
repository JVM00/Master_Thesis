\frame{\frametitle{NPL Drivers - Literature Review  }
\begin{itemize}

%\cite{ManzFlorian}

          \item Feedback links of financial intermediation and the real economy  \cite{Bernanke.1999}
          %\cite{BernankeBS.1981}
          \item Links between bank-specific characteristics and problem loans:
          
          
           \begin{itemize}
           \item Bad luck,bad management, skimping hypotheses, too big to fail behavior \cite{DeYoung.1997} \cite{Louzis.2012}
           \item Moral hazard hypothesis  \& risk-taking behavior \cite{EspinozaR.2010} 
            %\cite{KeetonWR.1987}
           %\cite{Boudriga}  \cite{SinkeyJF.1991} \cite{GhoshA.2015}
           
           \item Bank capitalization  \& risk appetite \cite{KwanS.1997} \cite{OseiAssibeyE.2015} 
        
           \item Strategic aspects of a banks' loan portfolio \cite{GhoshA.2017}
           %\cite{Zhang.2016}
           \item Geographic diversification \cite{BergerA.N.&DeYoungR.2001}
           
           \item Disaggregated loan aspects \cite{GoczekL.2015}
           
           %\cite{NkusuM.2011} \cite{Salas.2002}
           
           \end {itemize}
           
          \item Links between Macroeconomic characteristics and problem loans:
          
          \begin{itemize}
          
          \item Business cycle,terms of trade \& price levels \cite{Makri} \cite{Dimitrios.2016} 
          %\cite{Louzis.2012}
          \item Sovereign debt \cite{ReinhartCM.2011}
          %\cite{KleinN.2013} \cite{BockR.2012}
        \item Rule of law, Corporate Governance \& Supervision  \cite{Barth.2004}
        %\cite{Boudriga}
            
           
           \end {itemize}
           
           \item Usual empirical methods:
         
        \begin{itemize} 
        \item Linear  panel data methods & Dynamic panel data methods: GMM / OLS/VAR
        \item Unbalanced and balanced panel Data estimation techniques
        \end {itemize}
 
\item Type of data:
      \begin{itemize}
      \item Aggregate  (country) level
      \item Disaggregate (bank) level
      \end {itemize}
      
\item Framework: Geograhical (Global/national/regional), Temporal (Quaterly/semesterly/yearly)


      
          
 \end {itemize}

}

